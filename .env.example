# ==============================================================================
# BIRTHDAY PRODUCTION ENVIRONMENT SECRETS CONFIGURATION
# ==============================================================================

# Server Port (assigned by hosting provider, e.g., Render, Railway, Fly, Heroku)
PORT=3001
NODE_ENV=production

# Exact Unlock Date & Time in ISO 8601 format with timezone (+05:30 for Asia/Kolkata)
# Default: October 11, 2026, at 12:00:00 AM IST
BIRTHDAY_TARGET_TIME=2026-10-11T00:00:00+05:30

# Server-Side Secret Birthday PIN (Never exposed in frontend, bundled code, or public headers)
# Required PIN: 2311
BIRTHDAY_PIN=2311

# Cryptographically Secure Session Signing Secret (Minimum 32 bytes hex or random string)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_string

# AES-256-GCM Master Photo Encryption Key (32 bytes = 64-character hex string)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IMAGE_ENCRYPTION_KEY=replace_with_a_secure_random_64_character_hex_key
